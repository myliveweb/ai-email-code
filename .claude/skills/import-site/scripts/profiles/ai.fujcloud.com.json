    },
    "token": {
      "regex": "^(sk-[A-Za-z0-9]{20,})$",
      "note_to": "note"
    },
    "access_token": {
      "regex": "^([A-Za-z0-9+/=]{20,}=)$",
      "note_regex": "access\\s*token",
      "if_missing": "-"
    },
    "panel_id": {
      "regex": "^User ID\\s+(\\d+)$",
